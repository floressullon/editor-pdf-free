{
  "name": "editor-pdf-free",
  "version": "0.1.0",
  "description": "Editor de PDF gratuito y de código abierto: fusionar, organizar páginas, agregar texto, imágenes y firmas, resaltar y tapar. Funciona en el navegador y como app de escritorio.",
  "license": "MIT",
  "author": "Colaboradores del proyecto",
  "main": "electron/main.js",
  "keywords": [
    "pdf",
    "editor",
    "firma",
    "fusionar",
    "open-source",
    "pdf.js",
    "pdf-lib"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "vendor": "node scripts/copy-vendor.js",
    "start": "node scripts/serve.js",
    "desktop": "electron .",
    "package": "npm run vendor && electron-builder --config electron-builder.config.js",
    "package:win": "npm run vendor && electron-builder --config electron-builder.config.js --win",
    "package:mac": "npm run vendor && electron-builder --config electron-builder.config.js --mac",
    "package:linux": "npm run vendor && electron-builder --config electron-builder.config.js --linux"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
