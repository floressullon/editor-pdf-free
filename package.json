{
  "name": "editor-pdf-free",
  "version": "0.3.0",
  "description": "Editor de PDF gratuito y de código abierto: editar y borrar el texto existente, OCR, fusionar, organizar páginas, agregar texto, imágenes y firmas. Funciona en el navegador y como app de escritorio.",
  "license": "MIT",
  "author": "Colaboradores del proyecto",
  "main": "electron/main.js",
  "keywords": [
    "pdf",
    "editor",
    "firma",
    "fusionar",
    "open-source",
    "pdf.js",
    "pdf-lib",
    "ocr",
    "tesseract"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "vendor": "node scripts/copy-vendor.js",
    "start": "node scripts/serve.js",
    "desktop": "electron .",
    "package": "npm run vendor && electron-builder --config electron-builder.config.js",
    "package:win": "npm run vendor && electron-builder --config electron-builder.config.js --win",
    "package:mac": "npm run vendor && electron-builder --config electron-builder.config.js --mac",
    "package:linux": "npm run vendor && electron-builder --config electron-builder.config.js --linux",
    "single": "node scripts/build-single.js"
  },
  "optionalDependencies": {
    "@fontsource/bricolage-grotesque": "^5.0.0",
    "@fontsource/caveat": "^5.0.0",
    "@fontsource/dancing-script": "^5.0.0",
    "@fontsource/great-vibes": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "5.1.1"
  }
}
